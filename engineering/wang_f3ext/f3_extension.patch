+// ---------------------------------------------------------------------------
+// Odd prime fields (P = 3, 5, …; M = 1): the same √|G| split over 𝔽_P.
+//
+//   T_mat = Σ_{i,j,k} x_{ij} ⊗ y_{jk} ⊗ z_{ki} over 𝔽_P,
+//   G = (GL_{N0}(P) × GL_{N1}(P)) ⋊ C₂      (C₂ = transpose, cubic formats only).
+//
+// Unlike GL(n,2), the centre of GL(n,P) is the non-trivial group 𝔽_P^*·I, so the
+// projective group is G / 𝔽_P^*. We keep the full GL on each side: the split
+// still covers G (Query⁻¹·Store = {L⁻¹·τ(X)·R}), at a factor |𝔽_P^*| of
+// redundancy in the orbit enumeration.
+//
+// The constraint is the N0×N1 matrix of the Vec's base-P digits (flat index
+// ij = i·N1 + j, little-endian — the same order EncodeGFVec uses), so the
+// small-matrix algebra is delegated to a held FqMatrixTables<N0, N1> instance.
+// Store::Elem is the matrix data R and QuerySet::Elem is {l, transpose}, packed
+// exactly like the 𝔽₂ ones (l | transpose << 16), so certificate witnesses keep
+// their format.
+//
+// This is the extension that lets the matrix family run over 𝔽₃.
+// ---------------------------------------------------------------------------
+template <int P, int N0, int N1, int N2> class SymmetryGroupFq {
+  static_assert(P >= 3,
+                "SymmetryGroupFq is the odd-prime-field path; P = 2 uses "
+                "SymmetryGroupF2");
+  static_assert(N0 >= 1 && N1 >= 1 && N2 >= 1);
+  static_assert(N0 <= 4 && N1 <= 4,
+                "the GL lookup-table approach caps N0, N1 ≤ 4");
+  static_assert(N0 * N1 <= 16, "constraint must fit in the packed index");
+  static_assert(FqMatrix<P, N0, N0>::kCount <= 0xFFFFu,
+                "witness packing needs P^(N0·N0) ≤ 2^16 (e.g. GL(3,3) over 𝔽₃)");
+
+public:
+  static constexpr int kM = 1;
+  static constexpr int kNA = N0 * N1;
+  static constexpr bool kCubic = (N0 == N1 && N1 == N2);
+  using Vec = GFVec<P, 1, kNA>;
+
+private:
+  using Mat01 = FqMatrix<P, N0, N1>;
+  using Mat00 = FqMatrix<P, N0, N0>;
+  using Mat11 = FqMatrix<P, N1, N1>;
+  using Tables = FqMatrixTables<P, N0, N1>;
+
+  // Vec ↔ matrix: data[k] is the base-P digit at place k (= EncodeGFVec order).
+  static Mat01 ToMat(const Vec &v) {
+    uint32_t d = 0;
+    uint32_t place = 1;
+    for (int k = 0; k < kNA; ++k) {
+      d += static_cast<uint32_t>(v.data[k].value) * place;
+      place *= static_cast<uint32_t>(P);
+    }
+    return Mat01(d);
+  }
+  static Vec FromMat(const Mat01 &m) {
+    Vec r;
+    uint32_t d = m.Data();
+    for (int k = 0; k < kNA; ++k) {
+      r.Set(k, GF<P, 1>(static_cast<uint8_t>(d % static_cast<uint32_t>(P))));
+      d /= static_cast<uint32_t>(P);
+    }
+    return r;
+  }
+
+public:
+  // F₃ 3×3 的群作用快路径是否可用（见 core/rank_f3_fast.h 的 ApplyLeft3 / ApplyRight3）。
+  static constexpr bool kFast3 = (P == 3 && kM == 1 && N0 == 3 && N1 == 3);
+
+  using LinearTab = std::vector<std::array<std::uint8_t, sovereign_f3::kLinearTab>>;
+
+  // 左乘表 TabL[L]（W = L·τᵗ(V) 用）与右乘表 TabR[R]（W = V·R 用）, 见 core/rank_f3_fast.h。
+  static LinearTab BuildLeftTable() { return sovereign_f3::BuildLinearTable3(false); }
+  static LinearTab BuildRightTable() { return sovereign_f3::BuildLinearTable3(true); }
+
+  template <class T>
+  static const std::uint8_t *RowAt(std::uint32_t data, const T &tab) {
+    return tab[static_cast<std::size_t>(data)].data();
+  }
+
+  // 9 个数位 → Vec
+  static Vec VecFromDigits(const std::uint8_t w[9]) {
+    Vec r;
+    for (int k = 0; k < 9; ++k) {
+      r.Set(k, GF<P, kM>{w[k]});
+    }
+    return r;
+  }
+
+  // Vec 的 9 个数位（GF<3,1> 与 uint8 布局兼容, 框架自己也这样做 memcpy）
+  static const std::uint8_t *DigitsOfVec(const Vec &v) {
+    return reinterpret_cast<const std::uint8_t *>(v.data.data());
+  }
+
+  class StoreSet {
+  public:
+    using Elem = uint32_t;
+
+    explicit StoreSet(const Tables &tables) : tables_(tables) {
+      if constexpr (kFast3) {
+        tab_ = BuildRightTable();
+      }
+    }
+    int Size() const { return static_cast<int>(tables_.Gl1().size()); }
+    Elem At(int j) const { return tables_.Gl1()[j].Data(); }
+    Elem Identity() const { return tables_.Identity1().Data(); }
+    bool Contains(Elem r) const {
+      return r < Mat11::kCount && Mat11(r).IsInvertible();
+    }
+    Vec Apply(Elem r, Vec v) const {
+      if constexpr (kFast3) {
+        std::uint8_t w[9];
+        sovereign_f3::ApplyRightTab(RowAt(r, tab_), DigitsOfVec(v), w);
+        return VecFromDigits(w);
+      } else {
+        return FromMat(tables_.Mult011(ToMat(v), Mat11(r)));
+      }
+    }
+    Vec ApplyInverse(Elem r, Vec v) const {
+      if constexpr (kFast3) {
+        std::uint8_t w[9];
+        sovereign_f3::ApplyRightTab(RowAt(tables_.Inverse1(Mat11(r)).Data(), tab_), DigitsOfVec(v), w);
+        return VecFromDigits(w);
+      } else {
+        return FromMat(tables_.Mult011(ToMat(v), tables_.Inverse1(Mat11(r))));
+      }
+    }
+
+  private:
+    const Tables &tables_;
+    LinearTab tab_;
+  };
+
+  struct QueryElem {
+    uint32_t l = 0;
+    uint32_t transpose = 0;
+    constexpr QueryElem() = default;
+    constexpr QueryElem(uint32_t l_value, uint32_t transpose_flag)
+        : l(l_value), transpose(transpose_flag) {}
+    constexpr explicit QueryElem(uint32_t packed)
+        : l(packed & 0xFFFFu), transpose((packed >> 16) & 0xFFFFu) {}
+    constexpr explicit operator uint32_t() const {
+      return l | (transpose << 16);
+    }
+  };
+
+  class QuerySet {
+  public:
+    using Elem = QueryElem;
+    explicit QuerySet(const Tables &tables) : tables_(tables) {
+      if constexpr (kFast3) {
+        tab_ = BuildLeftTable();
+      }
+      const int t_count = kCubic ? 2 : 1;
+      for (int t = 0; t < t_count; ++t) {
+        for (const Mat00 &l : tables_.Gl0()) {
+          elems_.push_back(QueryElem{l.Data(), static_cast<uint32_t>(t)});
+        }
+      }
+    }
+    int Size() const { return static_cast<int>(elems_.size()); }
+    Elem At(int i) const { return elems_[i]; }
+    Elem Identity() const { return QueryElem{tables_.Identity0().Data(), 0}; }
+    bool Contains(Elem e) const {
+      return e.l < Mat00::kCount && Mat00(e.l).IsInvertible() &&
+             e.transpose <= (kCubic ? 1u : 0u);
+    }
+    Vec Apply(Elem e, Vec v) const {
+      if constexpr (kFast3) {
+        std::uint8_t w[9];
+        sovereign_f3::ApplyLeftTab(RowAt(e.l, tab_), e.transpose != 0, DigitsOfVec(v), w);
+        return VecFromDigits(w);
+      } else {
+        Mat01 m = ToMat(v);
+        if constexpr (kCubic) {
+          if (e.transpose) {
+            m = tables_.TransposeConstraint(m); // N0=N1: N1×N0 ≡ N0×N1
+          }
+        }
+        return FromMat(tables_.Mult001(Mat00(e.l), m));
+      }
+    }
+    Vec ApplyInverse(Elem e, Vec v) const {
+      if constexpr (kFast3) {
+        // 逆 of m ↦ l·τᵗ(m) 是 τᵗ(l⁻¹·m)
+        std::uint8_t u[9];
+        std::uint8_t w[9];
+        sovereign_f3::ApplyLeftTab(RowAt(tables_.Inverse0(Mat00(e.l)).Data(), tab_), false,
+                                   DigitsOfVec(v), u);
+        if (e.transpose) {
+          for (int i = 0; i < 3; ++i) {
+            for (int j = 0; j < 3; ++j) {
+              w[i * 3 + j] = u[j * 3 + i];
+            }
+          }
+        } else {
+          std::memcpy(w, u, 9);
+        }
+        return VecFromDigits(w);
+      } else {
+        Mat01 w = tables_.Mult001(tables_.Inverse0(Mat00(e.l)), ToMat(v));
+        if constexpr (kCubic) {
+          if (e.transpose) {
+            w = tables_.TransposeConstraint(w);
+          }
+        }
+        return FromMat(w);
+      }
+    }
+
+  private:
+    const Tables &tables_;
+    LinearTab tab_;
+    std::vector<Elem> elems_;
+  };
+
+private:
+  Tables tables_;
+
+public:
+  QuerySet query;
+  StoreSet store;
+
+  SymmetryGroupFq() : query(tables_), store(tables_) {}
+};
+
+// Dispatch: 𝔽₂ keeps the bit-packed tables; other prime fields use the base-P
+// digit tables. Resolved through a class template so that only the selected
+// branch is instantiated (a std::conditional alias would instantiate both).
+template <int P, int M, int N0, int N1, int N2, bool kIsF2 = (P == 2 && M == 1)>
+struct SymmetryGroupDispatch {
+  static_assert(M == 1, "matrix symmetry is over prime fields only (M = 1)");
+  using Type = SymmetryGroupFq<P, N0, N1, N2>;
+};
+
+template <int P, int M, int N0, int N1, int N2>
+struct SymmetryGroupDispatch<P, M, N0, N1, N2, true> {
+  using Type = SymmetryGroupF2<P, M, N0, N1, N2>;
+};
+
+template <int P, int M, int N0, int N1, int N2>
+using SymmetryGroup = typename SymmetryGroupDispatch<P, M, N0, N1, N2>::Type;
+
 } // namespace matrix
