+  // 评估一个节点（F₃，不同候选数 ≤ kF3MaxClasses）。
+  F3Node f3_evaluate(const Constraints<P, M, NA> &chain,
+                     const std::vector<uint32_t> &masks, uint32_t maskable) const {
+    F3State &st = f3_state();
+    F3Cache &cache = st.cache;
+    cache.HalveIfFull();
+    const uint32_t back = static_cast<uint32_t>(chain.size()) - 1;
+    // 1. 类：代表位置、重数、代表候选的下标与标签
+    st.rep_of_cls.clear();
+    st.mult.clear();
+    st.cls_cand.clear();
+    st.cls_tag.clear();
+    st.cls_of_pos.resize(back);
+    for (uint32_t p = 0; p < back; ++p) {
+      const uint32_t r = st.rep[p];
+      if (r == p) {
+        const uint32_t k = static_cast<uint32_t>(st.rep_of_cls.size());
+        st.cls_of_pos[p] = k;
+        st.rep_of_cls.push_back(p);
+        st.mult.push_back(1);
+        st.cls_cand.push_back(st.pos_cand[p]);
+        st.cls_tag.push_back(st.tags[st.pos_cand[p]]);
+      } else {
+        const uint32_t k = st.cls_of_pos[r];
+        st.cls_of_pos[p] = k;
+        st.mult[k] += 1;
+      }
+    }
+    CHECK_EQ(st.rep_of_cls.size(), maskable);
+    // 末行：它自己的类。back = 0 时 rep[0] = 0，走第一支（新的类）。
+    const uint32_t back_cls =
+        st.rep[back] == back ? maskable : st.cls_of_pos[st.rep[back]];
+    if (back_cls == maskable) {
+      st.cls_cand.push_back(st.pos_cand[back]);
+      st.cls_tag.push_back(st.tags[st.pos_cand[back]]);
+    }
+    CHECK_EQ(st.cls_cand.size(), static_cast<std::size_t>(back_cls) + 1);
+    const uint32_t subsets = uint32_t{1} << maskable;
+    const uint32_t back_bit = uint32_t{1} << back_cls;
+    st.mval.resize(subsets);
+    st.rank_of.resize(std::size_t{2} * subsets); // 下标 = all = kset | 末行位
+    std::fill(st.rank_of.begin(), st.rank_of.begin() + std::size_t{2} * subsets, uint8_t{0xFF});
+    st.pend_key.clear();
+    st.pend_val.clear();
+    st.mval[0] = 0;
+    for (uint32_t kset = 1; kset < subsets; ++kset) {
+      st.mval[kset] =
+          st.mval[kset & (kset - 1)] + st.mult[std::countr_zero(kset)];
+    }
+    // 2. 类子集按格雷码走：每步只翻转一个类，键跟着加 / 减一个标签。
+    //    末行的类恒在键里；它若也出现在可掩码位置上，翻转那一位不改变 all，也不改键。
+    //    两个不同的 kset 可以给出同一个 all（末行类在 / 不在 kset 里），用 rank_of 的备忘只查一次。
+    F3Node node;
+    F3Key key = st.cls_tag[back_cls];
+    uint32_t cur = 0;
+    for (uint32_t i = 0; i < subsets; ++i) {
+      if (i != 0) {
+        const uint32_t b = std::countr_zero(i);
+        const uint32_t bit = uint32_t{1} << b;
+        cur ^= bit;
+        if (b != back_cls) {
+          const F3Key &tg = st.cls_tag[b];
+          if (cur & bit) {
+            key.lo += tg.lo;
+            key.hi += tg.hi;
+          } else {
+            key.lo -= tg.lo;
+            key.hi -= tg.hi;
+          }
+        }
+      }
+      const uint32_t all = cur | back_bit;
+      if (st.rank_of[all] == 0xFF) {
+        const uint64_t h = f3_key_hash(key);
+        const F3Slot *slot = cache.Find(key, h);
+        if (slot != nullptr) {
+          st.rank_of[all] = slot->rank;
+        } else {
+          // 未缓存：拼出行向量，查轨道图；稍后统一插入
+          f3_build_rows(chain, maskable, back, all, &st.key);
+          st.key.insert(st.key.end(), base_constraints_.begin(),
+                        base_constraints_.end());
+          LocalMapValue v;
+          v.rank = static_cast<uint8_t>(
+              orbit_map_.Get(st.key, &v.query_elem, &v.store_elem));
+          st.rank_of[all] = v.rank;
+          st.pend_key.push_back(key);
+          st.pend_val.push_back(v);
+        }
+      }
+      node.self = std::max(node.self, static_cast<int>(st.mval[cur]) + 1 +
+                                           static_cast<int>(st.rank_of[all]));
+    }
+    // 3. 统一插入（插入会让上面取到的指针失效，所以放在查询之后）
+    for (std::size_t i = 0; i < st.pend_key.size(); ++i) {
+      cache.Insert(st.pend_key[i], f3_key_hash(st.pend_key[i]), st.pend_val[i]);
+    }
+    if (node.self < target_rank_lower_bound_) {
+      return node;
+    }
+    // 4. 闭合：取原顺序下第一个达到 target 的 mask（与上游逐 mask 循环相同）
+    for (uint32_t mask : masks) {
+      uint32_t all = uint32_t{1} << back_cls;
+      for (uint32_t m = mask; m != 0; m &= m - 1) {
+        all |= uint32_t{1} << st.cls_of_pos[std::countr_zero(m)];
+      }
+      const int value = std::popcount(mask) + 1 + static_cast<int>(st.rank_of[all]);
+      if (value >= target_rank_lower_bound_) {
+        node.closes = true;
+        node.close_mask = mask;
+        node.close_value = value;
+        // 见证：优先从缓存取；若第 3 步的插入触发了减半把它挤掉了，就再查一次轨道图。
+        F3Key key = st.cls_tag[back_cls];
+        for (uint32_t m = all & ~back_bit; m != 0; m &= m - 1) {
+          const F3Key &tg = st.cls_tag[std::countr_zero(m)];
+          key.lo += tg.lo;
+          key.hi += tg.hi;
+        }
+        const uint64_t h = f3_key_hash(key);
+        const F3Slot *slot = cache.Find(key, h);
+        if (slot != nullptr) {
+          node.close_witness.rank = slot->rank;
+          node.close_witness.query_elem = slot->query_elem;
+          node.close_witness.store_elem = slot->store_elem;
+        } else {
+          f3_build_rows(chain, maskable, back, all, &st.key);
+          st.key.insert(st.key.end(), base_constraints_.begin(),
+                        base_constraints_.end());
+          LocalMapValue v;
+          v.rank = static_cast<uint8_t>(
+              orbit_map_.Get(st.key, &v.query_elem, &v.store_elem));
+          CHECK_EQ(static_cast<int>(v.rank), static_cast<int>(st.rank_of[all]));
+          node.close_witness = v;
+        }
+        return node;
+      }
+    }
+    CHECK(false) << "f3_evaluate: node should close but no mask reaches target";
+    return node;
+  }
