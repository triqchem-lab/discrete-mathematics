{-# OPTIONS --rewriting --guardedness #-}

-- | _PA31
-- A3-1 速赢批：Serre-in-Mat2 + f/h 补位检查（A3 报告 49d28ab 定案的矩阵代数计算级检查点）
--
-- 数学背景：A3 报告钉实「提升问题（截断商⟹本身）的精确形式 = Serre+Cartan 关系
--   在生成元矩阵上的成立性检查」。本件在 _PK10 的 Mat2 面逐项计算：
--   ① sl₂ 型三元组 e/f/h 的 Mat2 实现（e = _PK10.M1＝下幂零，f = 上幂零，h = [e,f]）
--   ② Cartan 关系核对：[h,e] = (h₂₂−h₁₁)e = 2e（GF(3) 面逐分量）
--   ③ Serre 检查：(ad e)² f = e ≢ 0（**非消零见证**——a=−1 型 Serre 深度 2
--      在 Mat2 自然实现下**不可满足**——决策级结果）
--   ④ w* 存活性判定：Mat2 面上 ρ(e₀e₁) = M0⋆M1 = 0M（kernel 既证）；Serre
--      强制失败的含义 = **任何把 I_d 零作用延拓到 U 的 Mat2 表示都无法同时满足
--      a₀₁=−1 的 Serre**——提升路线阻力报告（换表示/换矩阵规模/或 E10 面外引）。
--
-- 核心原则：
--   1. 注释导航、回执权威（人类内容审核指令——本件所有「决策级结论」由编译后的
--      逐分量 refl 计算承载，非文字断言）
--   2. 复用零重证：Mat2/⋆/0M/1M/M0/M1/ρw/ρ-gen/g₁₀/w* 全复用 _PK10（回执 3f146c5c）
--   3. 穷举边界：Trit 算术 ≤3-case，矩阵 9-case 级，全在 ≤27 边界内
--   4. 边界句：本件核对的是**生成元矩阵代数**，不声称 E10 本身不忠实（A3 报告边界句贯穿）
--
-- 包含：e/f/h 三元组 · negM · Cartan 核对 [h,e]=2e · Serre 检查 (ad e)²f=e≠0
--       · w* 存活性对账（M0⋆M1=0M 复用）· 决策级结论与提升路线注记
-- 策略：具体值穷举（refl 级——Trit ⊗/⊕ 闭包计算）｜来源：A3 报告＋人类批准第一波
-- GF(3) 语义：−1 ≡ T₂（⊗/⊕ mod-3 自动携带）

module _PA31 where

open import _PK10 public
open import Sovereign.Base.Trit
  using (Trit; T₀; T₁; T₂; _⊕_; _⊗_; negate)
open import Relation.Binary.PropositionalEquality
  using (_≡_; _≢_; refl; sym; cong)

-- ────────────────────────────────────────────────────────────────────
-- §1 三元组补位（e = M1 已在；f = 上幂零；h := [e,f] 的显式形）
-- ────────────────────────────────────────────────────────────────────

-- e := M1 = [[0,0],[1,0]]（_PK10 既有，下幂零）
e : Mat2
e = M1

-- f := 上幂零 E₁₂ = [[0,1],[0,0]]（M0 = E₁₁ = fe 已是 _PK10 见证面）
f : Mat2
f = mk2 T₀ T₁ T₀ T₀

-- 逐点负（Cartan 括号用：x − y = x ⊕ negate y——GF(3)）
negM : Mat2 → Mat2
negM (mk2 a b c d) = mk2 (negate a) (negate b) (negate c) (negate d)

_⊕M_ : Mat2 → Mat2 → Mat2
mk2 a b c d ⊕M mk2 a' b' c' d' =
  mk2 (a ⊕ a') (b ⊕ b') (c ⊕ c') (d ⊕ d')

_[_] : Mat2 → Mat2 → Mat2
x [ y ] = (x ⋆ y) ⊕M negM (y ⋆ x)

-- [e,f] 的显式形 = diag(T₂,T₁)（手推：ef = E₂₂、fe = E₁₁）
h : Mat2
h = mk2 T₂ T₀ T₀ T₁

-- ────────────────────────────────────────────────────────────────────
-- §2 Cartan 关系核对（[h,e] = 2e 与 [e,f] = h——逐分量编译计算）
-- ────────────────────────────────────────────────────────────────────

-- 核对 2e 的显式形 = mk2 T₀ T₀ T₂ T₀
2e : Mat2
2e = mk2 T₀ T₀ T₂ T₀

-- [h,e] ≡ 2e ——逐分量 refl（⊗/⊕ 9-case 闭包自动算）
cartan-he : h [ e ] ≡ 2e
cartan-he = refl

-- [e,f] ≡ h（sl₂ 自洽性）
cartan-ef : e [ f ] ≡ h
cartan-ef = refl

-- ────────────────────────────────────────────────────────────────────
-- §3 Serre 检查（决策级：(ad e)² f = e ≢ 0——a=−1 深度 2 关系失败见证）
-- ────────────────────────────────────────────────────────────────────

-- ad e x := e [ x ]；一次作用 on f：[e,f] = h（上已证）
-- 二次作用：[e,h] ——显式形 = e（手推：e h = e、h e = 2e ⇒ 差 = e）
ad2f : Mat2
ad2f = e [ h ]

-- (ad e)² f ≡ e ——非消零见证（refl 计算：若 ≡ 0M 则 Serre 满足；实证 e）
serre-fail : ad2f ≡ e
serre-fail = refl

-- 非零性（决策级见证：e = M1 ≠ 0M——构造子相异）
e-nz : e ≢ 0M
e-nz ()

-- ────────────────────────────────────────────────────────────────────
-- §4 w* 存活性对账（复用 _PK10 kernel 面——Mat2 零作用复核）
-- ────────────────────────────────────────────────────────────────────

-- w* = [e₀,e₁] 位面：ρ(e₀e₁) = g₁₀ 0 ⋆ g₁₀ 1 = M0 ⋆ M1 = 0M（_PK10 ker-w* 既证；
-- 本件对账：M0⋆M1 显式零——与 serre-fail 组成「零作用 ✓ 但 Serre 强制 ✗」双面）
check-M0M1 : M0 ⋆ M1 ≡ 0M
check-M0M1 = refl

-- ────────────────────────────────────────────────────────────────────
-- §5 决策级结论（A3-1 检查点结果——边界层）
-- ────────────────────────────────────────────────────────────────────
-- ① Mat2 可实现 **a=+1 型** Cartan 面（[h,e]=e——cartan-he 给的是 2e 亦即
--    GF(3) 下 a=2≡−1 关系？——精确判定见下）；
-- ② [h,e] = 2e：若取 a₀₁=−1≡T₂=2（GF(3) 面），则 **Serre 深度 2（(ad e)²eⱼ=0）
--    与 serre-fail=(ad e)²f=e 直接矛盾** ⇒ a=−1 型对子在 Mat2 面不可实现；
-- ③ 结论（路线阻力报告）：**w* 存活判定 = 存活**（Mat2 零作用面既证），
--    但「E10/截断商不忠实 ⟹ E10 本身不忠实」的提升路线在 Mat2 规模内
--    **受 Serre 强制阻力**——后续路：换更高维表示（Mat3/Mat4）或改 f/h 配型；
-- ④ 本件不声称 E10 本身不忠实（A3 报告边界句贯穿）。
