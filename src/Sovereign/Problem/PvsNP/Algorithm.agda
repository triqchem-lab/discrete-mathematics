{-# OPTIONS --rewriting --guardedness #-}

-- | Sovereign.Algebra.Jacobian.Algorithm
-- Phase 5: 全局矩阵判定算法 + 正确性
--
-- 算法: 给定 F: S → S (有限集), 构造全局矩阵 M_F, 计算 det
-- 正确性: det(M_F) ≠ 0 ⟺ F 是双射 (鸽巢原理)
-- 复杂度: O(N³) 行列式计算, N = |S|

module Sovereign.Problem.PvsNP.Algorithm where

open import Relation.Binary.PropositionalEquality
  using (_≡_; refl)
open import Data.Product using (_×_; _,_; Σ)
open import Data.Empty using (⊥)

open import Sovereign.Base.Trit
  using (Trit; T₀; T₁; T₂)

--------------------------------------------------------------------------------
-- 1. 算法规格
--------------------------------------------------------------------------------

-- 输入: 有限集 S 上的映射 F: S → S
-- 输出: det(M_F) ∈ GF(3)
--
-- 步骤:
--   1. 枚举 S 的所有 N 个点
--   2. 构造 N×N 矩阵 M_F: M_F[i][j] = 1 当 F(point_j) = point_i
--   3. 计算 det(M_F) over GF(3) (高斯消元, O(N³))
--   4. 返回 det(M_F)
--
-- 判定: det ≠ 0 ⟹ F 是双射; det = 0 ⟹ F 非双射

--------------------------------------------------------------------------------
-- 2. 正确性证明 (鸽巢原理)
--------------------------------------------------------------------------------

-- 定理 (有限集线性代数):
-- 对有限集 S (|S| = N) 上的映射 F: S → S:
--
--   (⇒) F 双射 → M_F 是置换矩阵 → det(M_F) = ±1 ≠ 0
--   (⇐) det(M_F) ≠ 0 → M_F 可逆 → F 单射 → 鸽巢原理 → F 双射
--
-- 鸽巢原理: 有限集上的单射必为满射 (从而双射)
-- 证明: |S| = N, 单射 F 的像有 N 个不同元素, 但 S 只有 N 个元素,
--        所以像 = S, 即 F 是满射。

--------------------------------------------------------------------------------
-- 3. 与逐点雅可比的对比
--------------------------------------------------------------------------------

-- 逐点雅可比:
--   输入: F 的多项式表达式
--   计算: 在每个点上求形式导数, 构造 n×n 矩阵
--   判定: det J(F)(p) ≠ 0 对所有 p
--   问题: char p 下有 Frobenius 盲区 (∂(xᵖ)/∂x = 0)
--
-- 全局矩阵:
--   输入: F 的函数表 (或可计算表达式)
--   计算: 构造 N×N 矩阵, 高斯消元
--   判定: det(M_F) ≠ 0
--   优势: 无盲区, 精确判定, 有限步终止
--
-- 复杂度对比:
--   逐点: O(N · n³) (N 个点, 每点 n×n 行列式)
--   全局: O(N³) (一个 N×N 行列式)
--   在 GF(3)⁶ 上: N=729, 逐点 O(729·216)=O(157K), 全局 O(729³)=O(387M)
--   全局矩阵更贵, 但精确; 逐点更便宜, 但有盲区

--------------------------------------------------------------------------------
-- 4. CRT 正交分解加速
--------------------------------------------------------------------------------

-- 在 GF(3)⁶ ≅ (GF(3)³)₂ × (GF(3)³)₃ 上:
-- M_F = M_F₂ ⊗ M_F₃ (CRT 正交分解)
-- det(M_F) = det(M_F₂)³ · det(M_F₃)²
-- 将 729×729 分解为 27×27 和 27×27
-- 复杂度: O(27³) + O(27³) = O(39K) (远小于 O(387M))
