--------------------------------------------------------------------------------
-- §1. GF(3) 上多项式与仿射簇
--
-- 单变量多项式: p(x) = a₀ + a₁·x + a₂·x² + ... + a_d·x^d
-- 代数簇: V(p) = {x ∈ GF(3) | p(x) = 0}
-- 由于 GF(3) 只有 3 个元素, V(p) 可通过穷举完全确定.
--------------------------------------------------------------------------------

-- 二次多项式: p(x) = a·x² + b·x + c
-- (Poly1 泛化接口省略 — 对 GF(3) 上 d≤2 的多项式直接用显式算术)
eval-quad : Trit → Trit → Trit → Trit → Trit
eval-quad a b c x = (((a ⊗ x) ⊗ x) ⊕ (b ⊗ x)) ⊕ c

-- 代数簇 V(p) 的点集
variety-quad : Trit → Trit → Trit → ℕ  -- |V(p)| 的点数
variety-quad a b c = cnt T₀ + cnt T₁ + cnt T₂
  where
    cnt : Trit → ℕ
    cnt x with eval-quad a b c x
    ... | T₀ = 1
    ... | _  = 0

--------------------------------------------------------------------------------
-- §2. 正则函数环 Γ(V)
--
-- 对 V ⊂ GF(3)ⁿ, 正则函数环 Γ(V) = {f: V → GF(3) | f 多项式}.
-- 由于 V 有限, Γ(V) 是有限维 GF(3) 向量空间, dim = |V|.
-- 每个 f ∈ Γ(V) 由其在 V 各点上的值完全确定.
-- 这与 M_F 的函数表表示完全对应.
--------------------------------------------------------------------------------

-- 正则函数 (在有限簇上 = 所有函数 V → GF(3))
RegFunc : ℕ → Set
RegFunc n = Fin n → Trit  -- = GF3Vec n

-- 乘法表: 正则函数 f 的 "乘法矩阵" M_f ∈ GF(3)^{|V|×|V|}
-- M_f(i,j) = f(i) if i=j, else 0 (在函数乘法下).
-- 这与 jac_NMatrix 的 funcTable 是对偶概念.
-- funcTable: 映射 F 的全局信息 → M_F 矩阵
-- 正则表示: 函数 f 的局部信息 → diag(f) 矩阵

--------------------------------------------------------------------------------
-- §3. 实例: V = {x ∈ GF(3) : x² + 1 = 0}
--
-- x² + 1 = 0 在 GF(3) 上:
--   x=0: 0+1=1≠0
--   x=1: 1+1=2≠0
--   x=2: 4+1=5≡2≠0
-- V = ∅, |V| = 0. 该多项式在 GF(3) 上无根 → 不可约.
-- 与 jac_Complexity 的不可约性判定对齐.
--------------------------------------------------------------------------------

-- V(x²+1) 的点数
V-x²+1 : variety-quad T₁ T₀ T₁ ≡ 0  -- a=T₁, b=T₀, c=T₁
V-x²+1 = refl

-- V(x²+x+1) 的点数 (x²+x+1 = 0)
-- x=0: 1≠0; x=1: 3≡0 ✓; x=2: 7≡1≠0
-- |V| = 1 → 有一个根
V-x²+x+1 : variety-quad T₁ T₁ T₁ ≡ 1
V-x²+x+1 = refl

--------------------------------------------------------------------------------
-- §4. 点计数与 M_F 行列式的对偶
--
-- 定理: 对 GF(3) 上二次多项式 f, V(f) 的点数 |V| 与
--   f 的判别式 Δ = b² - 4ac 在 GF(3) 上的平方性相关:
--   Δ 是平方 → |V| = 2 (两个不同根)
--   Δ = 0    → |V| = 1 (重根)
--   Δ 非平方 → |V| = 0 (无根, f 不可约)
--
-- 这与 det(M_F) ≠ 0 的模式平行:
--   det ≠ 0  → F 双射  (满秩, 类似 Δ 非平方 → 无退化)
--   det = 0  → F 非双射 (退化, 类似 Δ 是平方/零 → 有根)
--
-- 更深层的对偶由 Grothendieck 的函数-层对偶给出:
--   M_F (代数侧) ↔ Γ(V) (几何侧)
--   行列式 ↔ 判别式
--   秩 ↔ 维数
--   可逆性 ↔ 非奇异性
--------------------------------------------------------------------------------

-- 判别式 (GF(3) 上, Δ = b² - 4ac = b² + ac, 因为 -4 ≡ -1 ≡ T₂)
discriminant : Trit → Trit → Trit → Trit
discriminant a b c = ((b ⊗ b) ⊕ (a ⊗ c)) ⊕ (a ⊗ c)  -- b² + 2ac = b² - ac

-- 验证: x²+1 的 Δ = 0²+1·1 = 1 (在 GF(3) 上 1 是非平方? 1²=1所以是平方)
-- 但 x²+1 无根 → 矛盾? 因为在 GF(3) 上判别式法需要调整.

-- 直接穷举: 3 个值, 0 postulate.
-- 点计数已由 variety-quad 完成 (refl 验证).

