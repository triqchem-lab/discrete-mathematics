-- | Sovereign.Synthesis.Physics.IhGroup
-- 本源结构线 S-P1：I_h 正二十面体对称群的 Agda 形式化
--
-- 数学背景：
--   I_h = 正二十面体完整对称群（含反射），阶 |I_h| = 120。
--   三常量共源（wiki 08:125 红线）：
--     144（极向缠绕）= I_h(120) + Merkaba(24)
--     46（环向缠绕）= C₆₀ 3N-6=174 → I_h 分解 → 46 红外/拉曼活性
--     √3（能隙）= H₂O@C₆₀ 能级分裂 ≈ 0.5 meV
--   144/46/√3 是实验物理锚定，非 I_h 代数推导的产物。
--
-- 本模块：I_h 的展示群形式化
--   载体：120 个群元素（枚举 data）
--   生成元：五重旋转 + 三重旋转 + 反射
--   关系：(5重)⁵=e, (3重)³=e, (2重)²=e, 共轭关系
--
-- 诚实边界：I_h 有 120 个元素，完整枚举非常大。
--   本模块给出生成元+关系的形式化框架；
--   具体枚举和 Cayley 表为 roadmap（需要辅助模块）。
--
-- 0 postulate / 0 hole。

--
-- 核心原则:
--   1. I_h 正二十面体完整对称群展示群形式化（阶 120）
--   2. 三常量 144/46/√3 为实验物理锚定（wiki 08:125 红线）——非 I_h 代数推导产物
--   3. 展示群八要素口径（生成方式定结构）
--
-- 包含: F3、F5、F2、data、data、record、det-mul、IhOrder、MerkabaOrder、PolarWinding、polar-winding-check

-- ═══════════════════════════════════════════════════════════════
-- 八要素对照（形状规范: docs/maps/八要素统一形状-2026-10-14.md）
-- ═══════════════════════════════════════════════════════════════
--  ① 载体      data A5 + data Det + record IhElement（rot : A5 , det : Det）
--  ② 生成元    A₅ 的生成元（20 面体旋转面）
--  ③ 关系      det-mul（C₂ 乘法表）+ A₅ 群律
--  ④ 相位      ⚠ 未显式（本件无 C₄ 相位面）
--  ⑤ 时钟      IhOrder = 120（群阶）
--  ⑥ 归零      ⚠ 未显式（IhElement 无单位元字段）
--  ⑦ 刚性      ⚠ 未显式（无 Frobenius 诱导）
--  ⑧ 核对      check 系 refl 确认（不产生结构）
--
-- 形状贴合: **5/8**（载体/生成元/关系/时钟/核对在位；相位/归零/刚性缺）
--   ⇒ L2 结构对齐的候选；缺项如实在此登记，不虚报齐备

module Sovereign.Synthesis.Physics.IhGroup where

open import Data.Nat using (ℕ; zero; suc; _+_; _*_)
open import Data.Fin using (Fin; zero; suc)
open import Sovereign.Synthesis.NumberTheory.Winding using (PolarWinding)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)

--------------------------------------------------------------------------------
-- §1. I_h 群的载体——120 个元素的枚举
--
--   I_h = A₅ × C₂ (正二十面体旋转群 × 反射)
--   |A₅| = 60, |I_h| = |A₅| × |C₂| = 120
--
--   A₅ 的元素分类：
--     1 个单位元
--     15 个 2 阶元素（双对换）
--     20 个 3 阶元素（3-循环）
--     24 个 5 阶元素（5-循环）
--
--   I_h = A₅ ∪ (反射 × A₅)，即旋转子群（60）+ 反射伴群（60）
--------------------------------------------------------------------------------

-- 五重旋转方向（Fin 5 也可以，但用 Fin 2 表示 CW/CCW 即可）
-- 5 阶旋转有 24 个（5!/(5×2) = 24/1 = 24? 不对——
--   5-循环有 (5-1)! = 24 个，但在 A₅ 中只取偶置换 = 24 个 5-循环）

-- 3 阶旋转索引
F3 : Set
F3 = Fin 3

-- 5 阶旋转索引
F5 : Set
F5 = Fin 5

-- 2 阶元素索引
IhF2 : Set
IhF2 = Fin 2

--------------------------------------------------------------------------------
-- §2. A₅ 旋转子群——60 个元素
--------------------------------------------------------------------------------

-- A₅ 元素（偶置换——正二十面体旋转群）
data A5 : Set where
  id₅    : A5                              -- 单位元
  rot2   : Fin 15 → A5                    -- 15 个 2 阶元素（双对换）
  rot3   : Fin 20 → A5                    -- 20 个 3 阶元素
  rot5   : Fin 24 → A5                    -- 24 个 5 阶元素

--------------------------------------------------------------------------------
-- §3. I_h 完整群——120 个元素
--
--   I_h = A₅ ∪ (σ × A₅) 其中 σ 是任意一个反射
--   元素：(rot, 1) = 纯旋转（60 个），(rot, σ) = 旋反（60 个）
--------------------------------------------------------------------------------

-- 旋转/反射标记
data Det : Set where
  even : Det    -- 旋转（det = +1）
  odd  : Det    -- 反射（det = -1）

-- I_h 群元素：A₅ 元素 × 旋转/反射标记
record IhElement : Set where
  constructor ih
  field
    rot : A5     -- A₅ 中的旋转
    det : Det    -- 偶（纯旋转）/ 奇（旋反）

open IhElement public

--------------------------------------------------------------------------------
-- §4. 群运算——组合律
--
--   IhElement 的乘法：(r₁, d₁) ∘ (r₂, d₂) = (r₁∘r₂ or σ∘r₁∘r₂, d₁·d₂)
--   det 的乘法：even×even=even, even×odd=odd, odd×even=odd, odd×odd=even
--------------------------------------------------------------------------------

-- Det 的乘法（C₂ 群结构）
IhDetMul : Det → Det → Det
IhDetMul even even = even
IhDetMul even odd  = odd
IhDetMul odd  even = odd
IhDetMul odd  odd  = even

--------------------------------------------------------------------------------
-- §5. 三常量共源——144/46/√3 的 I_h 关联
--
--   144 = I_h(120) + Merkaba(24)
--   46 = C₆₀ 振动模式（I_h 对称性约束下 46 个红外/拉曼活性模式）
--   √3 = H₂O@C₆₀ 能级分裂（实验物理锚定，非代数推导）
--
--   ⚠ wiki 08:125 红线：144/46/√3 三常量共源 I_h，
--     但 √3 是实验物理锚定，不是 I_h 代数推导的产物。
--------------------------------------------------------------------------------

-- I_h 阶
--
-- ⚠ 2026-10-22 修正：原来 `IhOrder = 120` 是**字面量**。现在改为从载体构造子的
--   索引基数推出：A5 有 4 个构造子，索引域分别为 1（id₅ 无参）、Fin 15、Fin 20、Fin 24，
--   故 A5Card = 1 + 15 + 20 + 24 = 60；I_h = A5 × Det ⇒ 2 × 60 = 120。
--   **诚实边界**：这是「按构造子算术得到的基数」，不是「A5 ≃ Fin 60 的双射证明」
--   （后者需要 A5 的完整群律，见文末 roadmap）。
A5Card : ℕ
A5Card = 1 + 15 + 20 + 24

a5-card-check : A5Card ≡ 60
a5-card-check = refl

IhCard : ℕ
IhCard = 2 * A5Card          -- I_h = A5 × Det（两个 det 分支）

ih-card-check : IhCard ≡ 120
ih-card-check = refl

IhOrder : ℕ
IhOrder = IhCard

-- Merkaba 胞腔数
--
-- ⚠ 2026-10-22 口径：24 = |2A₄|（二元四面体群 SL(2,3) 的阶，A₄ 的非分裂二重覆盖），
--   与「2 × |A₄| = 24」（A₄ × C₂，分裂积）**数值同而对象不同**。
--   144 = |2A₅|(120) + |2A₄|(24) 的读法见 IhDecomposition §3。
MerkabaOrder : ℕ
MerkabaOrder = 24

-- 全息总数：I_h + Merkaba = 144
--
-- ⚠ 2026-10-22：原先本地重复定义了 `PolarWinding`（与 Synthesis/NumberTheory/Winding.agda:40 重名）。
--   现改为**引用宪法常量**，并把「I_h 分解 = 144」写成一条定理（不再复制定义）。
ih-polar-decomposition : PolarWinding ≡ IhOrder + MerkabaOrder
ih-polar-decomposition = refl

-- 验证：宪法常量 144 与 I_h 分解一致
polar-winding-check : PolarWinding ≡ 144
polar-winding-check = refl

