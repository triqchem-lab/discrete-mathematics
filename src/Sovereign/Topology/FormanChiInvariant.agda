c₀ = 3
c₁ = 3
c₂ = 1

m₀ m₁ m₂ : ℕ
m₀ = 2
m₁ = 1
m₂ = 0

p₀ p₁ p₂ : ℕ
p₀ = 1
p₁ = 1
p₂ = 0

-- 分解恒等式逐维核验（实例层 refl）
partition-0 : c₀ ≡ m₀ + p₀
partition-0 = refl

partition-1 : c₁ ≡ m₁ + p₁ + p₀
partition-1 = refl

partition-2 : c₂ ≡ m₂ + p₂ + p₁
partition-2 = refl

-- χ 双侧闭合（实例层）
chi-c-instance : chi-c c₀ c₁ c₂ ≡ 1
