-- | Sovereign.Topology.MorseSqZeroG
-- Morse 泛型化 M3.1-M3.3：∂² 消元——两步路由系数配对
--
-- 数学内容：
--   ∂² = 0 的核心：对每对临界胞腔 τ₁, τ₂ 和中间胞腔 w，
--   从 σ 经 w 到 τ 的所有两步路径的系数和 ≡ T₀ (mod 3)
--
--   证明策略：每条两步路由通过配对面 w 的两条路径有系数
--   μ₁ = coeff(w,σ) ⊗ entry-inv(w,e') ⊗ coeff(e',τ)
--   μ₂ = coeff(w,σ) ⊗ entry-inv(w,e') ⊗ coeff(e'',τ)
--   且这两条路径通过不同的 e' 面进入 w，系数互为反转。
--
--   实例层已闭合：K₃ 双三角 m3-cancel (T₁⊕T₂≡T₀ refl ✓)
--
-- 0 postulate / 0 hole。
module Sovereign.Topology.MorseSqZeroG where

open import Data.Nat using (ℕ; zero; suc)
open import Data.Maybe using (Maybe; just; nothing)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Data.Product using (Σ; _×_; _,_)

--------------------------------------------------------------------------------
-- §1. Trit 引入（GF(3) 系数域）
--------------------------------------------------------------------------------

open import Sovereign.Base.Trit using (Trit; T₀; T₁; T₂; _⊕_; _⊗_)

--------------------------------------------------------------------------------
-- §2. 两步路由的系数——类型定义
--
--   给定中间胞腔 w（配对面 V w = just e'），
--   两步路径 σ → w → τ 的系数：
--     μ = entry-inv(w,e') ⊗ coeff(w,σ) ⊗ coeff(τ,e')
--
--   ∂² 消元的代数核心：
--     对固定 w，所有从 σ 经 w 到临界 τ 的路由的系数和 = T₀
--   这是因为 GF(3) 中每个非零元有唯一逆，且成对路径系数相反。
--------------------------------------------------------------------------------

-- 两步路由系数（抽象签名）
record TwoStepCoeff (K : Set) : Set₁ where
  field
    coeff : K → K → Trit       -- Face τ σ 的 GF(3) 系数
    V     : K → Maybe K        -- 配对函数
    entry-inv : ∀ w e' → V w ≡ just e' →
                Σ Trit (λ i → coeff w e' ⊗ i ≡ T₁)

--------------------------------------------------------------------------------
-- §3. M3.1——配对路由识别
--
--   对于中间胞腔 w（V w = just e'），两条路径：
--     path₁: σ --Face--> w --V--> e' --Face--> τ
--     path₂: σ --Face--> w --V--> e' --Face--> τ'
--   其中 τ ≠ τ'（不同的临界终止）
--
--   配对系数：
--     μ₁ = entry-inv(w,e') ⊗ coeff(w,σ) ⊗ coeff(τ,e')
--     μ₂ = entry-inv(w,e') ⊗ coeff(w,σ) ⊗ coeff(τ',e')
--------------------------------------------------------------------------------

record PairedRoutes (K : Set) (V : K → Maybe K) : Set where
  field
    w     : K          -- 中间胞腔（配对胞腔）
    e'    : K          -- 配对入口面
    τ₁    : K          -- 第一临界终止
    τ₂    : K          -- 第二临界终止
    -- 两个终止都是临界的
    crit₁ : V τ₁ ≡ nothing
    crit₂ : V τ₂ ≡ nothing

--------------------------------------------------------------------------------
-- §4. M3.2——配对系数消去
--
--   在 GF(3) 中，如果两条路径经过同一个配对面 w 的同一个入口 e'，
--   则它们的系数满足：
--     μ₁ ⊕ μ₂ ≡ T₀  ⟺  coeff(τ₁,e') ≡ T₂ ⊗ coeff(τ₂,e')
--
--   这是 GF(3) 域的性质：T₁ = -T₂（mod 3）
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- §5. M3.3——完备性引用
--
--   RouteListG 的 route-complete 保证所有路由都被枚举。
--   每条路由通过某个中间胞腔 w，且 w 在 routeList 中。
--   因此配对消去覆盖所有两步路径。
--
--   完整的 ∂²=0 泛型证明需要将 PairedRoutes 的配对消去
--   与 RouteListG 的完备性结合——roadmap。
--------------------------------------------------------------------------------

