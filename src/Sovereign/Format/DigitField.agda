{-# OPTIONS --rewriting --guardedness #-}

module Sovereign.Format.DigitField where

-- | Sovereign.Format.DigitField —— **位域层**
--
-- ── 范畴声明（本模块只谈这一件事）────────────────────────────────────────
--   · **位域（digit field）** = 字内的一段字段，由**状态数**（容量）刻画：
--     一个字段能取多少种值、如何划分成更小的字段。
--     位域层的事实是纯粹的容量算术（乘、幂、比较），**不含任何记数法语义**。
--   · **进制（numeral base / radix）** = 记数法：位值权重 `b^k`、位的取值范围 `0..b−1`、
--     逢 b 进一。这是**另一个范畴**，见 `Sovereign.Format.Positional` / `Sovereign.Format.Doz`。
--   · 两者之间的桥（用某个位域去承载某个进制的位）见 `Sovereign.Format.DigitRealization`。
--
-- ── 禁止的表述（本模块的存在就是为了挡住它）─────────────────────────────
--   ❌ 「12 进制 = 3 × 2 × 2」
--      `12 = 3·2²` 是**位域容量**的分解；进制 12 是记数法的**基**，是被记的数（权重 12^k 的来源），
--      不是被拼装的字段。把两者写成等号是范畴错误。
--   ✅ 「一个 12 态位域可由 1 个三态域 + 2 个二态域拼成」（本模块）
--   ✅ 「以 12 为底的记数法（Doz）的每一位 ∈ {0..11}，权重 12^k」（进制层）
--   ✅ 「12 态位域与一位十二进制数位之间有一一对应（双射）」（桥层 —— 是双射，不是同一）
--
-- 登记于 `docs/duodecimal/08-terminology.md` §7.5。
--
-- 本模块全部引理都是 ℕ 上的 `refl` 等式：Agda 直接算，无需任何判定递归
-- （Nat 的 `_≤?_` 复杂度是 O(min m n)，对 3²⁷ 量级会在类型检查器里跑几十亿步，
--  所以容量比较一律写成 `a ≡ b + k` / `c ≡ suc a + k'` 的等式形式）。

open import Data.Nat using (ℕ; _*_; _^_; _+_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)

--------------------------------------------------------------------------------
-- 1. 单个位域的容量
--------------------------------------------------------------------------------

-- 位域的容量就是它的状态数
FieldCapacity : Set
FieldCapacity = ℕ

-- 12 态位域 = 1 个三态域 × 2 个二态域（容量相乘）
capacity-12 : 3 * (2 * 2) ≡ 12
capacity-12 = refl

-- 2 个二态域就是一个 4 态位域
capacity-4 : 2 * 2 ≡ 4
capacity-4 = refl

--------------------------------------------------------------------------------
-- 2. 整个字的位域划分容量
--------------------------------------------------------------------------------

-- 27 个位置全排三态域
capacity-27trit : 3 ^ 27 ≡ 7625597484987
capacity-27trit = refl

-- 27 个位置全排二态域
capacity-27bit : 2 ^ 27 ≡ 134217728
capacity-27bit = refl

-- 43 个二态域（与 27 个三态域同为常见的字宽对照）
capacity-43bit : 2 ^ 43 ≡ 8796093022208
capacity-43bit = refl

-- 混合划分：9 个三态域 + 18 个二态域
capacity-9t-18b : 3 ^ 9 * 2 ^ 18 ≡ 5159780352
capacity-9t-18b = refl

--------------------------------------------------------------------------------
-- 3. 位域之间的容量比较（仍只用状态数）
--------------------------------------------------------------------------------

-- 43 个二态域 > 27 个三态域（位置数不同，比的是总容量，不是每位置密度）
bit43-over-trit27 : 2 ^ 43 ≡ 3 ^ 27 + 1170495537221
bit43-over-trit27 = refl

-- 27 个三态域 > 9 个三态域 + 18 个二态域（27 个三态位置比混合划分更宽）
trit27-over-9t18b : 3 ^ 27 ≡ 3 ^ 9 * 2 ^ 18 + 7620437704635
trit27-over-9t18b = refl
