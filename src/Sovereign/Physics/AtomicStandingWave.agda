--------------------------------------------------------------------------------
-- §1. 原子驻波 = T⁶ 闭合相位轨道
--------------------------------------------------------------------------------

-- 标准量子力学: k·a = nπ (驻波条件)
-- 大衍框架: T⁶ 环面上 GF(9) 矢量场的相位闭合

-- 驻波条件: ψ(x+a) = ψ(x) · α^n
-- 其中 n 是整数, α 是 GF(9) 的 90° 旋转元

-- α 的旋转阶 = 4 (已证)
alpha-order : ℕ
alpha-order = 4

-- 驻波闭合: α⁴ = 1 (四步归位)
wave-closure : ((alpha *gf9 alpha) *gf9 alpha) *gf9 alpha ≡ gf9-one
wave-closure = alpha-powers-4

-- φ 的旋转阶 = 8 (已证)
phi-order : ℕ
phi-order = 8

-- 半步闭合: φ² = α (45°→90°)
half-step-closure : phi *gf9 phi ≡ alpha
half-step-closure = phi-squared

-- 全步闭合: φ⁸ = 1 (45°×8=360°)
full-step-closure : (((phi *gf9 phi) *gf9 (phi *gf9 phi)) *gf9 ((phi *gf9 phi) *gf9 (phi *gf9 phi))) ≡ gf9-one
full-step-closure = phi-to-8

-- 驻波模式的相位序列:
--   α⁰ = 1  → 0° (单位)
--   α¹ = α  → 90° (第一步)
--   α² = -1 → 180° (第二步)
--   α³ = -α → 270° (第三步)
--   α⁴ = 1  → 360° (回到单位)

-- 六重态驻波 (T⁶ 六维对称性):
--   六个相位副本 = α⁰, α¹, α², α³, α⁴, α⁵
--   对应氢原子在受限空间中的六个等价位置
--   已在 WaterAnchors.agda 中通过零幂族解释

--------------------------------------------------------------------------------
-- §2. 量子场势垒 = 范数边界
--------------------------------------------------------------------------------

-- 标准量子力学: 势垒 = 高势能区域, 波函数指数衰减
-- 大衍框架: 势垒 = GF(9) 范数边界 (N=1 → N=2)

-- GF(9) 范数只能取三个值: 0, 1, 2
-- N=0: 零态 (绝对零度极限)
-- N=1: 非零单位态 (液态/气态, 波函数传播)
-- N=2: 最大偏离态 (固态/临界态, 波函数受限)

-- 范数分布 (已验证):
--   N=0: 1 个元素 (零态)
--   N=1: 4 个元素 (单位态)
--   N=2: 4 个元素 (最大偏离态)

-- N=0 的元素: (0,0)
norm-zero : galoisNorm gf9-zero ≡ T₀
norm-zero = refl

-- N=1 的元素: (0,1), (0,2), (1,0), (2,0)
norm-one-alpha : galoisNorm alpha ≡ T₁
norm-one-alpha = refl

norm-one-neg-alpha : galoisNorm (T₀ , T₂) ≡ T₁
norm-one-neg-alpha = refl

-- N=2 的元素: (1,1), (1,2), (2,1), (2,2)
norm-two : galoisNorm (T₁ , T₁) ≡ T₂
norm-two = refl

-- 势垒边界: N 从 1 跃迁到 2
-- 这是离散跃迁, 不是连续变化

--------------------------------------------------------------------------------
-- §3. 穿越势垒 = 范数投影的相变
--------------------------------------------------------------------------------

-- 标准量子力学: 隧穿 (连续, 概率性)
-- 大衍框架: 范数投影的相变 (离散, 确定性)

-- 温度驱动的相变:
--   高温: N=1 (液态/气态, 波函数传播)
--   临界点: N 从 1 跃迁到 2
--   低温: N=2 (固态/临界态, 波函数受限)

-- 相变的 GF(9) 表示:
--   高温态: (a,b) 满足 a²+b² = 1 (mod 3)
--   低温态: (a,b) 满足 a²+b² = 2 (mod 3)
--   相变: 范数从 1 跃迁到 2

-- 范数=1 的元素 (传播态)
propagating-states : ℕ
propagating-states = 4  -- (0,1), (0,2), (1,0), (2,0)

-- 范数=2 的元素 (受限态)
confined-states : ℕ
confined-states = 4  -- (1,1), (1,2), (2,1), (2,2)

-- 传播态与受限态的比 = 1:1 (对称性)
state-ratio : propagating-states ≡ confined-states
state-ratio = refl

-- 矢量解释:
--   穿越势垒不是"隧穿" (连续概率)
--   而是范数从 N=1 跃迁到 N=2 (离散相变)
--   跃迁是确定性的, 不是概率性的

--------------------------------------------------------------------------------
-- §4. 六重态 = T⁶ 驻波模式的对称副本
--------------------------------------------------------------------------------

-- 语料: 水分子在绿柱石晶体 ~5Å 六边形通道中
--   氢原子同时处于围绕氧原子的六个等价位置
--   动能 EK ≈ 95 meV (低于普通液态水 ~150 meV)

-- 框架映射:
--   六个位置 = T⁶ 六维对称性的驻波模式副本
--   每个位置对应 GF(9) 的一个 α 旋转:
--     位置 0: α⁰ = 1  (0°)
--     位置 1: α¹ = α  (90°)
--     位置 2: α² = -1 (180°)
--     位置 3: α³ = -α (270°)
--     位置 4: α⁴ = 1  (360°, 回到位置 0)
--     位置 5: α⁵ = α  (450°, 回到位置 1)

-- 六重态的相位差 (每步 90°, 但六重态需要 60° 步长)
-- 在 GF(9) 中: α 阶 4 (90° 步长)
-- 六重态需要 60° 步长 → 需要 φ (45° 步长) 的近似
-- 但 φ 阶 8, 不是 6

-- 六重态的精确解释:
--   T⁶ = (x,y,z,cL,cR,g) 六个分量
--   每个分量 ∈ GF(3) = {0,1,2}
--   六重态 = 六个分量的循环置换
--   不是 α 旋转的六步, 而是 T⁶ 维度的六重对称性

-- 动能降低: 95 meV < 150 meV
-- 框架解释: 零态的相位空间是单点 → 无方向动能 → EK 降低
-- 95/150 ≈ 0.633 → 约 63% 的动能保留

