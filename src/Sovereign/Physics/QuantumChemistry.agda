-- §5. 离散角度体系: 精确离散值
--------------------------------------------------------------------------------

-- 在大衍框架中, 角度不是连续实数, 而是离散的相位值
-- 每个角度对应 GF(9) 中的一个乘法操作

-- α 的乘法表 (已证):
--   α⁰ = 1  → 0° (单位)
--   α¹ = α  → 90° (第一步)
--   α² = -1 → 180° (第二步)
--   α³ = -α → 270° (第三步)
--   α⁴ = 1  → 360° (回到单位)

-- φ 的乘法表 (已证):
--   φ⁰ = 1  → 0°
--   φ¹ = φ  → 45° (半步)
--   φ² = α  → 90° (全步)
--   φ³ = αφ → 135°
--   φ⁴ = -1 → 180°
--   φ⁵ = -φ → 225°
--   φ⁶ = -α → 270°
--   φ⁷ = -αφ → 315°
--   φ⁸ = 1  → 360° (回到单位)

-- 水的键角 104.5° 在离散角度体系中:
--   90° (α) + 14.5° (修正) ≈ 104.5°
--   14.5° 不是精确的离散值, 而是连续修正的离散近似
--   在严格离散框架中: 键角 = 90° (α 步长)

-- 离散角度值 (已证):
angle-0   : ℕ; angle-0   = 0    -- 单位
angle-45  : ℕ; angle-45  = 45   -- φ 步长
angle-90  : ℕ; angle-90  = 90   -- α 步长
angle-180 : ℕ; angle-180 = 180  -- α² = -1
angle-270 : ℕ; angle-270 = 270  -- α³ = -α
angle-360 : ℕ; angle-360 = 360  -- α⁴ = 1

-- 矢量解释:
--   离散角度体系 = GF(9) 乘法群的旋转表
--   每个角度 = 一个乘法操作
--   连续角度 (如 104.5°) 是离散值的插值, 不是本体

