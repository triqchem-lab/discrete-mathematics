-- E(F9) 群律表驱动: cls6 代表元 c021 的 7 点群（M6 · B5/G1 试点（含结合律））
--
-- TraceTable: t = -3（超奇异）; 同构类 = CurveIsoF3.cls6
--   （iso-class 与 (Fix, pairs) 组合不变量逐类一致, oracle iso/frob 交叉核对）
--   点集 = E(F9) 全点（含无穷远 ptInf; 坐标见 §0 注释, oracle group 公式枚举承载）
--   全部表格由 oracle emit-group 逐字生成（先算后验）; G0 已核对:
--   群公理/σ 群自同/特征方程 [4]P=[t]·σP 全点 ✓
--
-- 诚实边界:
--   · Agda 侧承载表内性质（单位/逆/交换/结合/σ-自同/特征方程);
--     表的坐标语义由 oracle 公式枚举承载（G0）
--   · σ 的群自同 = 点级置换等式; End(E) 环论意义（Deuring ρ^2=-3）需群律公式层, 未排期
--   · 数值子句全部 emit-group 生成（先算后验纪律）

module Sovereign.Application.Problems.RH.GroupCls6 where

open import Relation.Binary.PropositionalEquality using (_≡_; refl)

--------------------------------------------------------------------------------
-- §0. 点表（oracle group 冻结; ptInf = 无穷远点）
--------------------------------------------------------------------------------

-- ptInf = ∞
-- pt1 = ((0, 0), (1, 0))
-- pt2 = ((0, 0), (2, 0))
-- pt3 = ((1, 0), (1, 0))
-- pt4 = ((1, 0), (2, 0))
-- pt5 = ((2, 0), (1, 0))
-- pt6 = ((2, 0), (2, 0))

data Pt6 : Set where
  ptInf pt1 pt2 pt3 pt4 pt5 pt6 : Pt6

-- σ 置换（f9conj 点级像; B0 冻结）
sig : Pt6 → Pt6
sig ptInf = ptInf
sig pt1 = pt1
sig pt2 = pt2
sig pt3 = pt3
sig pt4 = pt4
sig pt5 = pt5
sig pt6 = pt6

-- neg 置换（-(x,y) = (x,−y)）
