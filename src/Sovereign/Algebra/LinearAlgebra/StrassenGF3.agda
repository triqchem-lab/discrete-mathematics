-- | Sovereign.Algebra.LinearAlgebra.StrassenGF3
-- M13: Strassen 2×2 七乘方案的 GF(3) 全枚举正确性（M13·N0 oracle 冻结）
--
-- 数学背景:
--   · Strassen 1969: 2×2 矩阵乘法 7 次乘法（朴素 8）——ω-型改进的最小完整实例
--   · 本件: 7 门方案在 GF(3) 上的**全枚举正确性**——3⁸ = 6561 组输入逐组 refl
--     （先算后验: engineering/oracle_strassen_gf3.py 全枚举核对后逐字发射）
--   · 次数账本: strassen 的 ⊗ 门恰 7 个（m1..m7 各一）; 朴素 mulMat2 为 8 ⊗
--     ——离散寄存器对 ω 问题的构造性答案（账本层; 渐近 ω 不在本库边界）
--
-- 诚实边界:
--   · 下界（7 为最小, Hopcroft–Kerr）不作陈述 [边界外]
--   · 渐近 ω（OpenAI ω ≤ 9/4 等）不在本库边界——见
--     docs/techniques/OpenAI-omega-9-4-只读审计-2026-11-25.md

module Sovereign.Algebra.LinearAlgebra.StrassenGF3 where

open import Data.Nat using (ℕ)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Sovereign.Base.Trit using (Trit; T₀; T₁; T₂; _⊕_; _⊗_; negate)
open import Sovereign.Algebra.LinearAlgebra.Matrix2
  using (Mat2; mkMat2; mulMat2)

_⊖_ : Trit → Trit → Trit
x ⊖ y = x ⊕ negate y

-- §1. 七门（每门恰一次 ⊗）

m1 m2 m3 m4 m5 m6 m7 : Mat2 Trit → Mat2 Trit → Trit
m1 (mkMat2 a _ _ d) (mkMat2 e _ _ h) = (a ⊕ d) ⊗ (e ⊕ h)
m2 (mkMat2 _ _ c d) (mkMat2 e _ _ _) = (c ⊕ d) ⊗ e
m3 (mkMat2 a b _ _) (mkMat2 _ f _ h) = a ⊗ (f ⊖ h)
m4 (mkMat2 _ _ _ d) (mkMat2 e _ g _) = d ⊗ (g ⊖ e)
m5 (mkMat2 a b _ _) (mkMat2 _ _ _ h) = (a ⊕ b) ⊗ h
m6 (mkMat2 a _ c d) (mkMat2 e f _ _) = (c ⊖ a) ⊗ (e ⊕ f)
m7 (mkMat2 _ b _ d) (mkMat2 _ _ g h) = (b ⊖ d) ⊗ (g ⊕ h)

-- §2. Strassen 输出组合（仅 ⊕/⊖; 无额外 ⊗）

strassen : Mat2 Trit → Mat2 Trit → Mat2 Trit
strassen A B =
  mkMat2
    (((m1 A B ⊕ m4 A B) ⊕ negate (m5 A B)) ⊕ m7 A B)
    ((m3 A B ⊕ m5 A B))
    ((m2 A B ⊕ m4 A B))
    (((m1 A B ⊕ negate (m2 A B)) ⊕ m3 A B) ⊕ m6 A B)

mul₃ : Mat2 Trit → Mat2 Trit → Mat2 Trit
mul₃ = mulMat2 _⊕_ _⊗_

-- §3. ★ 全枚举正确性（3⁸ = 6561 条 refl; oracle 逐字发射）

strassen-correct :
  ∀ (a b c d e f g h : Trit) →
    strassen (mkMat2 a b c d) (mkMat2 e f g h)
    ≡ mul₃ (mkMat2 a b c d) (mkMat2 e f g h)
