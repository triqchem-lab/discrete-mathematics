-- | Sovereign.Algebra.Analytic.SymmetricFunctions
-- 对称函数基础：置换不变面（定义层）与初等对称函数 e₂/e₃
--
-- 数学背景：对称函数 = 在坐标置换下不变的多元函数（表示论特征标/幂和/初等对称函数
--   均属此族）；e₂(a,b,c)=ab+ac+bc、e₃(a,b,c)=abc 为三元初等对称函数经典形。
--   本模块落**定义层（置换不变面 record）+ 三元具名实例（e₂/e₃ + 置换不变性证明）**——
--   ⚠ 域错配预防：实例走 ℕ 计数形（具名三元组——避开置换作用向量的约定坑）；
--   一般 (Fin n → ℕ) 面与 GF(3)/A₄ 特征标衔接立界注记。
-- 核心原则：
-- 1. 关系入定义（SymmetricFn 的不变性 = record 字段 symm；导出性质不入字段）
-- 2. 置换以「作用-逆对 + 逆律」自足承载（免 stdlib Permutation 约定依赖）
-- 3. 实例证明走具名步骤（*−comm 桥，≤2 步短链）；穷举边界内
-- 4. 立界注记显式（不设空壳签名——零洞纪律）
--
-- 包含：SymmetricFn · pvec · e₂3 · e₃3 · 置换不变性 ×2 · 数值核对 ×2 · 衔接注记 · 立界注记

module Sovereign.Algebra.Analytic.SymmetricFunctions where

open import Data.Nat using (ℕ; zero; suc; _+_; _*_)
open import Data.Fin using (Fin) renaming (zero to fzero; suc to fsuc)
open import Relation.Binary.PropositionalEquality
open import Data.Nat.Properties using (*-comm; +-comm; +-assoc)

------------------------------------------------------------------------
-- §1 对称函数定义层（置换不变面——关系入定义）
------------------------------------------------------------------------

-- 重排作用：向量 x 经 σ 重排 = x ∘ σ
pvec : ∀ {n} → (σ : Fin n → Fin n) → (Fin n → ℕ) → (Fin n → ℕ)
pvec σ x i = x (σ i)

-- 对称函数：f 在任意可逆重排下不变（可逆性以作用-逆对 + 逆律承载——自足形）
record SymmetricFn (n : ℕ) : Set₁ where
  field
    f : (Fin n → ℕ) → ℕ
    symm : ∀ (σ σ⁻ : Fin n → Fin n)
         → (∀ i → σ⁻ (σ i) ≡ i)
         → ∀ x → f (pvec σ x) ≡ f x

------------------------------------------------------------------------
-- §2 三元初等对称函数（具名形——ℕ 计数面）
------------------------------------------------------------------------

-- e₂(a,b,c) = ab + ac + bc（左结合展开形）
e₂3 : ℕ → ℕ → ℕ → ℕ
e₂3 a b c = (a * b) + (a * c) + (b * c)

-- e₃(a,b,c) = abc
e₃3 : ℕ → ℕ → ℕ → ℕ
e₃3 a b c = (a * b) * c

------------------------------------------------------------------------
-- §3 置换不变性（具名证明——*−comm 桥短链）
------------------------------------------------------------------------

-- e₂3 在前二交换下不变：ab+ac+bc ≡ ba+bc+ac
--   证明链：①中段首项交换（*−comm 一步）②尾两项交换（mid-swap 三步辅件）
mid-swap : ∀ x y z → (x + y) + z ≡ (x + z) + y
mid-swap x y z = trans (+-assoc x y z)
                (trans (cong (λ t → x + t) (+-comm y z)) (sym (+-assoc x z y)))

-- 主不变性：e₂3 a b c ≡ e₂3 b a c（前二交换）
e₂3-swap : ∀ a b c → e₂3 a b c ≡ e₂3 b a c
e₂3-swap a b c =
  trans (cong (λ t → (t + (a * c)) + (b * c)) (*-comm a b)) (mid-swap (b * a) (a * c) (b * c))

-- e₃3 在前二交换下不变（一步 *−comm 桥）
e₃3-swap : ∀ a b c → e₃3 a b c ≡ e₃3 b a c
e₃3-swap a b c = cong (λ t → t * c) (*-comm a b)

