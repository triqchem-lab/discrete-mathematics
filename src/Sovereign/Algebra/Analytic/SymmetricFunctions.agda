-- §4 数值核对（defeq 级）
------------------------------------------------------------------------

check-e23-111 : e₂3 1 1 1 ≡ 3
check-e23-111 = refl

check-e33-234 : e₃3 2 3 4 ≡ 24
check-e33-234 = refl

