{-# OPTIONS --rewriting --guardedness #-}

-- | Sovereign.Algebra.ExponentDimension
-- 零幂族与方向数映射 + 指数=维度语义
--
-- 零幂族 (Zero Power Family):
--   零幂不是算术乘法 (0×0=0), 而是量子矢量相位回归的代数形式。
--   零是唯一能跨维度的元素: 0^n = 0 对所有 n ≥ 1。
--   零吸收一切幂次, 零的相位空间是单点 (无方向自由度)。
--   0² 不是"零的平方", 而是"零的二次幂 = 零" (零幂族)。
--   语料: "零的平方=零的五次方……零的一就等于零的N次方" (word_98)
--   语料: "只有0跨维度" / "0是一切的密码" (ppt_27, ppt_7)
--
-- 研究 3: 零幂指数与方向数映射
--   云端: 0²=2方向, 0⁶=6方向, 0¹¹=11方向, 0¹⁵=15方向
--   问题: 指数 11 与 α 阶 4 矛盾 (应为 10)
--   结论: 这是命名层语义压缩, 不是代数关系
--     0^n = 0 (代数事实, 已证 zero-power-gf9)
--     "0²=2方向" 中的 2 是指数, 不是零幂的值
--     命名层: 指数 n 标记"方向数", 零幂只说明该方向归零
--
-- 研究 4: "指数 = 维度方向计数" 的可形式化性
--   在 GF(9)* 中: 元素的阶 = 该元素生成的循环子群的大小
--   α 的阶 = 4 → α 生成 4 个方向 (0°, 90°, 180°, 270°)
--   φ 的阶 = 8 → φ 生成 8 个方向 (每 45° 一个)
--   "指数 = 维度方向计数" 在此意义上可形式化
--
-- 0 postulate.

module Sovereign.Algebra.ExponentDimension where

open import Data.Nat using (ℕ; zero; suc; _+_; _*_; _%_; _^_)
open import Data.Product using (_×_; _,_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl; trans)

open import Sovereign.Algebra.GF9
  using (GF9; gf9-one; gf9-zero; alpha; phi; _*gf9_; gf9-pow; zero-power-gf9)

--------------------------------------------------------------------------------
-- §1. 零幂指数分类 (命名层)
--------------------------------------------------------------------------------

-- 代数事实: 0^n = 0 对所有 n ≥ 1 (已证 zero-power-gf9)
-- 命名层: 指数 n 标记语义分层, 零幂只说明该方向归零

-- 指数 2: "光之矩阵" 方向
-- 指数 6: "情感矩阵" 方向
-- 指数 11: "克里斯托" 方向 (注: 11 可能是 10 的转写, 因 α 阶 4 中 10≡2 mod 4)
-- 指数 15: "更高层" 方向

-- 所有这些在代数上都是同一个零元:
zero-pow-2  : gf9-pow gf9-zero 2  ≡ gf9-zero; zero-pow-2  = refl
zero-pow-6  : gf9-pow gf9-zero 6  ≡ gf9-zero; zero-pow-6  = refl
zero-pow-11 : gf9-pow gf9-zero 11 ≡ gf9-zero; zero-pow-11 = refl
zero-pow-15 : gf9-pow gf9-zero 15 ≡ gf9-zero; zero-pow-15 = refl

-- 转录问题: 11 vs 10
-- α² = -1 (阶 2 元素), α^10 = α^(4·2+2) = α² = -1
-- 如果语料中 "0¹¹" 实际是 "0¹⁰", 则指数与 α 的阶结构对齐 (10 ≡ 2 mod 4)
-- 但无论指数是 10 还是 11, 0^n = 0 不受影响

--------------------------------------------------------------------------------
-- §2. 指数 = 维度方向计数 (可形式化)
--------------------------------------------------------------------------------

-- 在 GF(9)* 中:
--   α 的阶 = 4 → ⟨α⟩ = {1, α, -1, -α} = 4 个方向
--   φ 的阶 = 8 → ⟨φ⟩ = GF(9)* = 8 个方向
--   -1 的阶 = 2 → ⟨-1⟩ = {1, -1} = 2 个方向

-- "指数 = 维度方向计数" 的精确含义:
--   元素 g 的阶 = g 生成的循环子群的大小 = g 能到达的不同方向数

-- α 生成 4 个方向
alpha-order : ℕ
alpha-order = 4  -- α^0=1, α^1=α, α^2=-1, α^3=-α, α^4=1

-- φ 生成 8 个方向 (全部 GF(9)*)
phi-order : ℕ
phi-order = 8  -- φ 生成整个乘法群

-- -1 生成 2 个方向
neg1-order : ℕ
neg1-order = 2

-- 子群链: 2 ⊂ 4 ⊂ 8 (已在 DivisibilityChain 证)
-- 即: ⟨-1⟩ ⊂ ⟨α⟩ ⊂ ⟨φ⟩ = GF(9)*

-- "指数 = 维度方向数" 在此框架中可形式化:
--   给定元素 g ∈ GF(9)*, ord(g) = g 能旋转到的不同位置数 = "维度方向数"
--   零元 0 不在乘法群中, 所以 "0 的方向数" 是命名层语义

--------------------------------------------------------------------------------
-- §3. α 阶 4 与指数 2/6/10 的关系
--------------------------------------------------------------------------------

-- α² = -1 (阶 2 元素, 180°)
-- α⁶ = α⁴·α² = 1·(-1) = -1 = α² (因为 α⁴=1)
-- α¹⁰ = α⁸·α² = 1·(-1) = -1 = α² (因为 α⁸=1)
-- 所以: α^(4k+2) = -1 对所有 k

-- 形式化: α^(2+4k) 的值 (用 gf9-pow)
-- 注意: gf9-pow 的定义是 gf9-pow x zero = gf9-one, gf9-pow x (suc n) = x * gf9-pow x n

--------------------------------------------------------------------------------
-- §4. 零幂跨维度: 矢量相位回归的代数形式
--------------------------------------------------------------------------------

-- ⚠️ 深度澄清:
--   "只有0跨维度" 不是算术游戏 (任何数乘以0等于0)。
--   在动态幻方框架中:
--     · 归零是量子矢量相位回归, 是过程不是状态
--     · 零矢量的相位空间是单点, 无方向自由度
--     · 所以零在任何维度方向上的相位演化都回归到零
--     · 这是"跨维度"的精确含义: 零是唯一能在所有方向上保持不变的矢量
--
--   与指数塔的统一:
--     零幂: 0^n = 0 — 零矢量无方向自由度
--     指数塔: 12↑↑k ≡ 0 (mod m) — 12 的倍数性使相位通道闭合
--     共同机制: 相位空间退化, 不是算术吸收
--
--   DuodecClock 中:
--     Z/3 分量: 12 ≡ 0 (mod 3) → 加法相位回归
--     ⟨α⟩ 分量: 12 ≡ 0 (mod 4) → 乘法相位回归 (α^12 = 1)
--     联合: (0, 1) = 动态幻方的不动点

