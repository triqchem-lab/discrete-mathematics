{-# OPTIONS --rewriting --guardedness #-}

-- | Sovereign.Algebra.HenselModPow2
-- 任务书第三层·3.2 SOVEREIGN_LCM 前置 P1：mod 2¹⁶ 的 x² ≡ 1 四根定理（实例层）
--
-- 数学背景：与质幂模 3^k 不同，mod 2^k（k ≥ 3）的 x² ≡ 1 恰有 **4 个根**：
--   {1, 2^k−1, 2^(k−1)+1, 2^(k−1)−1}。
--   对 k = 16：恰 {1, 65535, 32769, 32767}。
--   本模块给出四正根见证 + 代表性非根排除；完备性（无第五根）需
--   coprimality 论证（gcd(a,a+1)=1 ⟹ 2^14∣a 或 2^14∣a+1）——roadmap。
--
-- 0 postulate / 0 hole。
module Sovereign.Algebra.HenselModPow2 where

open import Data.Nat using (ℕ; zero; suc; _*_; _+_; _<_; _≤_)
open import Data.Empty using (⊥)
open import Data.Nat.Divisibility
  using (_∣_; ∣m+n∣m⇒∣n; ∣⇒≤; n∣m*n)
open import Relation.Nullary using (¬_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Sovereign.Algebra.HenselLiftUniqueness using (≤<-asym; 1+<-trans)

∣65536-step : ∀ {m r : ℕ} → 65536 ∣ (m + r) → 65536 ∣ m → 65536 ∣ r
∣65536-step = ∣m+n∣m⇒∣n

--------------------------------------------------------------------------------
-- §1. 四正根见证
--------------------------------------------------------------------------------

-- x = 1 : x²-1 = 0
root-1 : 65536 ∣ 0
root-1 = n∣m*n 0

-- x = 32767 = 2^15−1 : x²-1 = 1073676288 = 16383·65536
root-32767 : 65536 ∣ 1073676288
root-32767 = n∣m*n 16383

-- x = 32769 = 2^15+1 : x²-1 = 1073807360 = 16385·65536
root-32769 : 65536 ∣ 1073807360
root-32769 = n∣m*n 16385

-- x = 65535 = 2^16−1 : x²-1 = 4294836224 = 65534·65536
root-65535 : 65536 ∣ 4294836224
root-65535 = n∣m*n 65534

--------------------------------------------------------------------------------
-- §2. 代表性非根排除
--------------------------------------------------------------------------------

-- x = 3 : x²-1 = 8 = 0·65536 + 8
¬65536∣8 : ¬ (65536 ∣ 8)
¬65536∣8 h =
  ≤<-asym 65536 8
    (∣⇒≤ h)
    (1+<-trans 65527 8)

-- x = 5 : x²-1 = 24
¬65536∣24 : ¬ (65536 ∣ 24)
¬65536∣24 h =
  ≤<-asym 65536 24
    (∣⇒≤ h)
    (1+<-trans 65511 24)

-- x = 16383 : x²-1 = 268402688 = 4095·65536 + 32768
¬65536∣268402688 : ¬ (65536 ∣ 268402688)
¬65536∣268402688 h =
  ≤<-asym 65536 32768
    (∣⇒≤ (∣65536-step h (n∣m*n 4095)))
    (1+<-trans 32767 32768)

-- x = 49151 : x²-1 = 2415820800 = 36862·65536 + 32768
¬65536∣2415820800 : ¬ (65536 ∣ 2415820800)
¬65536∣2415820800 h =
  ≤<-asym 65536 32768
    (∣⇒≤ (∣65536-step h (n∣m*n 36862)))
    (1+<-trans 32767 32768)

--------------------------------------------------------------------------------
-- §3. 结构性论证注记（完备性——coprimality roadmap）
--
--   若 x² ≡ 1 (mod 2^16)，则 x 为奇数，令 x = 2a+1。
--   x²−1 = 4a(a+1)，故 2^14 ∣ a(a+1)。
--   因 gcd(a, a+1) = 1，得 2^14 ∣ a 或 2^14 ∣ (a+1)。
--   前者 x = 2^15·b + 1 ⟹ x ∈ {1, 32769}；
--   后者 x = 2^15·b − 1 ⟹ x ∈ {32767, 65535}。
--   ⟹ 恰四根。完整形式化需 Coprimality 机件（roadmap）。
--------------------------------------------------------------------------------
