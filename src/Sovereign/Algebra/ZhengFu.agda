module Sovereign.Algebra.ZhengFu where

open import Data.Nat using (ℕ; zero; suc; _+_; _*_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)

--------------------------------------------------------------------------------
-- §1. 正负数数据类型——正负术的本体论贡献
--------------------------------------------------------------------------------

data 正负 : Set where
  正 : ℕ → 正负    -- 正数
  负 : ℕ → 正负    -- 负数（绝对值）
  零 : 正负        -- 零

--------------------------------------------------------------------------------
-- §2. 基本操作
--------------------------------------------------------------------------------

-- 取绝对值
absⁿ : 正负 → ℕ
absⁿ (正 n) = n
absⁿ (负 n) = n
absⁿ 零     = 0

-- 取符号（正=T₁, 负=T₂, 零=T₀——Trit 编码）
sgn : 正负 → ℕ
sgn (正 _) = 1
sgn (负 _) = 2
sgn 零     = 0

--------------------------------------------------------------------------------
-- §3. 同号加法（可定义——异号需比较，roadmap）
--------------------------------------------------------------------------------

-- 同号加法：正+正=正，负+负=负
同号加 : 正负 → 正负 → 正负
同号加 (正 a) (正 b) = 正 (a + b)
同号加 (负 a) (负 b) = 负 (a + b)
同号加 x y = x       -- 含零的情形（简化）


--------------------------------------------------------------------------------
-- §3.5 乘法（正负乘法——无需比较！符号律直接给出）
--
--   正×正=正，正×负=负，负×正=负，负×负=正
--   乘法的符号律不需要大小比较——这是乘法优于加法之处
--------------------------------------------------------------------------------

_乘_ : 正负 → 正负 → 正负
(正 a) 乘 (正 b) = 正 (a * b)
(正 a) 乘 (负 b) = 负 (a * b)
(负 a) 乘 (正 b) = 负 (a * b)
(负 a) 乘 (负 b) = 正 (a * b)
零 乘 _   = 零
_   乘 零 = 零

-- 乘法交换律：需要 *-comm（非定义性——ℕ 乘法交换是定理非 refl）
-- 乘-comm : ∀ (a b : 正负) → (a 乘 b) ≡ (b 乘 a)
-- 乘-comm (正 a) (正 b) = cong 正_ (*-comm a b)  -- 需 Data.Nat.Properties.*-comm
-- 其余 case 类似——roadmap

