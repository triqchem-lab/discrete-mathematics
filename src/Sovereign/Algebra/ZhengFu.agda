module Sovereign.Algebra.ZhengFu where

open import Data.Nat using (ℕ; zero; suc; _+_; _*_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)

--------------------------------------------------------------------------------
-- §1. 正负数数据类型——正负术的本体论贡献
--------------------------------------------------------------------------------

data 正负 : Set where
  正 : ℕ → 正负    -- 正数
  负 : ℕ → 正负    -- 负数（绝对值）
  零 : 正负        -- 零

--------------------------------------------------------------------------------
-- §2. 基本操作
--------------------------------------------------------------------------------

-- 取绝对值
absⁿ : 正负 → ℕ
absⁿ (正 n) = n
absⁿ (负 n) = n
absⁿ 零     = 0

-- 取符号（正=T₁, 负=T₂, 零=T₀——Trit 编码）
sgn : 正负 → ℕ
sgn (正 _) = 1
sgn (负 _) = 2
sgn 零     = 0

--------------------------------------------------------------------------------
-- §3. 同号加法（可定义——异号需比较，roadmap）
--------------------------------------------------------------------------------

-- 同号加法：正+正=正，负+负=负
同号加 : 正负 → 正负 → 正负
同号加 (正 a) (正 b) = 正 (a + b)
同号加 (负 a) (负 b) = 负 (a + b)
同号加 x y = x       -- 含零的情形（简化）

--------------------------------------------------------------------------------
-- §4. 验证
--------------------------------------------------------------------------------

-- 同号加法
test-same-pos : 同号加 (正 3) (正 5) ≡ 正 8
test-same-pos = refl

test-same-neg : 同号加 (负 3) (负 5) ≡ 负 8
test-same-neg = refl

-- 基本构造
test-abs : absⁿ (负 7) ≡ 7
test-abs = refl

test-sgn : sgn (正 5) ≡ 1
test-sgn = refl

test-sgn-neg : sgn (负 3) ≡ 2
test-sgn-neg = refl

