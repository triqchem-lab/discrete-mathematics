-- §4. 验证
--------------------------------------------------------------------------------

-- 同号加法
test-same-pos : 同号加 (正 3) (正 5) ≡ 正 8
test-same-pos = refl

test-same-neg : 同号加 (负 3) (负 5) ≡ 负 8
test-same-neg = refl

-- 乘法验证
test-mul-pos-pos : (正 3) 乘 (正 5) ≡ 正 15
test-mul-pos-pos = refl

test-mul-pos-neg : (正 3) 乘 (负 5) ≡ 负 15
test-mul-pos-neg = refl

test-mul-neg-neg : (负 3) 乘 (负 5) ≡ 正 15
test-mul-neg-neg = refl


-- 基本构造
test-abs : absⁿ (负 7) ≡ 7
test-abs = refl

test-sgn : sgn (正 5) ≡ 1
test-sgn = refl

test-sgn-neg : sgn (负 3) ≡ 2
test-sgn-neg = refl

