--------------------------------------------------------------------------------
-- §1. 损益操作
--------------------------------------------------------------------------------

-- 损一：律管长度 × 2/3（可整除时）
sun : ℕ → ℕ
sun n = (n * 2) / 3

-- 益一：律管长度 × 4/3 = 2²/3（可整除时）
yi : ℕ → ℕ
yi n = (n * 4) / 3

-- 可损判定：3 ∣ 2n ⟺ 3 ∣ n
can-sun : ℕ → Set
can-sun n = (n * 2) ≢ 0

-- 可益判定：3 ∣ 4n ⟺ 3 ∣ n
can-yi : ℕ → Set
can-yi n = (n * 4) ≢ 0

