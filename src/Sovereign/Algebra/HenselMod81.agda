-- | Sovereign.Algebra.HenselMod81
-- 任务书第三层·3.2 延伸：mod 81 的 x² ≡ 1 根全景（p = 3⁴ 实例）
--
-- 数学背景：Hensel 线（mod 9/27 已闭）延伸到 p = 3⁴。mod 27 根
--   x ≡ 1, 26 各提升三候选（+27k, k = 0,1,2）：
--     x ≡ 1 ↦ {1, 28, 55}；x ≡ 26 ↦ {26, 53, 80}
--   逐候选机器见证：
--     根：x = 1（81∣0，Tower 谱系）、x = 80（81∣6399 = 79·81）
--     非根：x = 26（¬81∣675）、x = 53（¬81∣2808）、
--           x = 28（¬81∣783）、x = 55（¬81∣3024）
--   ⟹ mod 81 根全景（六候选内）：恰 {1, 80}——与奇 p 幂理论
--   （x² ≡ 1 mod p^k 恰两根 ±1）一致。
--
--   证法（复用 HenselLiftMod27 模式 + stdlib ∣m+n∣m⇒∣n 下降）：
--     若 81∣N 且 81∣(N 的 81 倍数部分)，则 81∣余项 r；
--     ∣⇒≤ 给 81 ≤ r，与 r < 81（1+<-trans 链）经 ≤<-asym 矛盾。
--
-- 0 postulate / 0 hole。
module Sovereign.Algebra.HenselMod81 where

open import Data.Nat using (ℕ; zero; suc; _*_; _+_; _<_; _≤_)
open import Data.Empty using (⊥)
open import Data.Nat.Divisibility
  using (_∣_; ∣m+n∣m⇒∣n; ∣⇒≤; n∣m*n)
open import Data.Nat.Properties using (≤-refl; ≤-trans)
open import Relation.Nullary using (¬_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Sovereign.Algebra.HenselLiftUniqueness using (≤<-asym; 1+<-trans)

--------------------------------------------------------------------------------
-- §1. 泛型一步：81∣(m + r) → 81∣m → 81∣r（stdlib ∣m+n∣m⇒∣n 直给）
--------------------------------------------------------------------------------

∣81-step : ∀ {m r : ℕ} → 81 ∣ (m + r) → 81 ∣ m → 81 ∣ r
∣81-step = ∣m+n∣m⇒∣n


--------------------------------------------------------------------------------
-- §3. 四非根见证（每条：81∣(81倍数 + 余项) → 81∣余项 → ⊥）
--------------------------------------------------------------------------------

-- x = 26：26² - 1 = 675 = 648 + 27（648 = 8·81）
¬81∣675 : ¬ (81 ∣ 675)
¬81∣675 h = ≤<-asym 81 27 (∣⇒≤ (∣81-step h 81∣8·81)) (1+<-trans 53 27)
  where
    81∣8·81 = n∣m*n 8

-- x = 28：28² - 1 = 783 = 729 + 54（729 = 9·81）
¬81∣783 : ¬ (81 ∣ 783)
¬81∣783 h = ≤<-asym 81 54 (∣⇒≤ (∣81-step h 81∣9·81)) (1+<-trans 26 54)
  where
    81∣9·81 = n∣m*n 9

-- x = 53：53² - 1 = 2808 = 2754 + 54（2754 = 34·81）
¬81∣2808 : ¬ (81 ∣ 2808)
¬81∣2808 h = ≤<-asym 81 54 (∣⇒≤ (∣81-step h 81∣34·81)) (1+<-trans 26 54)
  where
    81∣34·81 = n∣m*n 34

-- x = 55：55² - 1 = 3024 = 2916 + 108（2916 = 36·81）
¬81∣3024 : ¬ (81 ∣ 3024)
¬81∣3024 h = ≤<-asym 81 27 (∣⇒≤ (∣81-step h 81∣37·81)) (1+<-trans 53 27)
  where
    81∣37·81 = n∣m*n 37

--------------------------------------------------------------------------------
-- §4. 正根见证（Tower 谱系：x = 1 与 x = 80）
--------------------------------------------------------------------------------

-- x = 1：81∣0（81 倍数，平凡根）
root-1 : 81 ∣ 0
root-1 = n∣m*n 0

-- x = 80：80² - 1 = 6399 = 79·81 ✓
root-80 : 81 ∣ 6399
root-80 = n∣m*n 79
