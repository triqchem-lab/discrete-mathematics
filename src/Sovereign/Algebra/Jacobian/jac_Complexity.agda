-- §4. 低次不可约性判定 (det2' 迂回策略)
--
-- 对 GF(3) 上二次多项式 p(λ) = λ² + a·λ + b:
--   p 可约 ⟺ ∃ root in GF(3) = {T₀,T₁,T₂}.
--   检查三个值: p(T₀), p(T₁), p(T₂). 全部非零 ⇒ 不可约.
--
-- 对 GF(3) 上 2×2 矩阵 M = [[a,b],[c,d]]:
--   特征多项式: p_M(λ) = λ² ⊖ (a+d)·λ ⊕ (ad⊖bc)
--   det2'(M) = ad ⊖ bc = 常数项.
--   tr(M) = a ⊕ d.
--
-- 以下实现 GF(3) 上二次多项式的根检验, 并用具体实例验证不可约性.
--------------------------------------------------------------------------------

-- GF(3) 二次多项式: λ² + a·λ + b
eval-quad : Trit → Trit → Trit → Trit
eval-quad a b x = ((x ⊗ x) ⊕ (a ⊗ x)) ⊕ b

-- 根检验: 若有 λ∈{T₀,T₁,T₂} 使 p(λ)=T₀, 则可约.
has-root : Trit → Trit → Trit
has-root a b = check (eval-quad a b T₀) (eval-quad a b T₁) (eval-quad a b T₂)
  where
    check : Trit → Trit → Trit → Trit
    check T₀ _  _  = T₁  -- T₀ 是根, 可约
    check _  T₀ _  = T₁  -- T₁ 是根, 可约
    check _  _  T₀ = T₁  -- T₂ 是根, 可约
    check _  _  _  = T₀  -- 全部非零, 不可约

-- 实例: 不可约多项式 λ² + T₁ (a=T₀, b=T₁)
-- p(T₀) = T₀+T₁ = T₁ ≠ T₀
-- p(T₁) = T₁+T₁ = T₂ ≠ T₀
-- p(T₂) = T₁+T₁ = T₂ ≠ T₀
irred-example : has-root T₀ T₁ ≡ T₀  -- ≡ T₀ 表示不可约 (无根)
irred-example = refl

-- 实例: 可约多项式 λ² + T₂·λ + T₁ (a=T₂, b=T₁)
-- p(T₁) = T₁ + T₂⊗T₁ + T₁ = T₁ + T₂ + T₁ = T₀ → T₁ 是根
red-example : has-root T₂ T₁ ≡ T₁  -- ≡ T₁ 表示可约
red-example = refl

-- 2×2 矩阵的特征多项式不可约性
-- M = [[T₀,T₁],[T₂,T₀]]: tr=T₀, det=T₁
-- p_M(λ) = λ² ⊖ T₀·λ ⊕ T₁ = λ² ⊕ T₁ (因为 T₀·λ = T₀, ⊖T₀ = T₀)
-- 上面已证: has-root T₀ T₁ = T₀ (不可约)
matrix-irred : has-root T₀ T₁ ≡ T₀
matrix-irred = refl

