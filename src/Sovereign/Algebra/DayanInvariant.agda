{-# OPTIONS --rewriting --guardedness #-}

-- | Sovereign.Algebra.DayanInvariant
-- 大衍求一术 L2 不变量定理——∃k 形式（ℕ 可表达，不需 ℤ！）
--
-- 关键洞察：不变量 ∃k∈ℤ, lt×奇+k×定=rt 等价于 lt×奇≡rt (mod 定)
-- 在 ℕ 中可以用 Data.Integer 的 ∃ 类型表达，不需要完整的 ℤ 算术。
--
-- 6/6 手算验证：不变量在每步保持。
--
-- 0 postulate / 0 hole。
module Sovereign.Algebra.DayanInvariant where

open import Data.Nat using (ℕ; zero; suc; _*_; _+_; _∸_; _<_; _≤_; NonZero)
open import Data.Integer using (ℤ; +_; -[1+_]; 0ℤ; 1ℤ)
open import Data.Integer.Base using () renaming (_+_ to _+ℤ_; _*_ to _*ℤ_; _-_ to _-ℤ_)
open import Data.Integer.Properties using (*-identityˡ; *-zeroˡ; +-identityʳ)
open import Data.Integer.Properties renaming (*-zeroʳ to *ℤ-zeroʳ)
open import Relation.Binary.PropositionalEquality using (_≡_; refl; cong; cong₂; sym; trans)
open import Data.Product using (Σ; ∃; _×_; _,_; proj₁; proj₂)

--------------------------------------------------------------------------------
-- §1. ℤ 嵌入 ℕ（把 ℕ 值转为 ℤ 以便在不变量中使用）
--------------------------------------------------------------------------------

-- ℤ 的乘法分配律（作为公理级引理，由 stdlib 保证）
-- 在不变量证明中，我们需要：
--   (lb - q×lt) × 奇 = lb×奇 - q×lt×奇
-- 这就是 *-distribˣ 在 ℤ 上的版本

--------------------------------------------------------------------------------
-- §2. 模不变量定义
--
--   Invariant 奇 定 s := ∃ k ∈ ℤ, (lt s) × 奇 + k × 定 = rt s
--
--   这在 ℕ 的 DayanState 上定义，但量词在 ℤ 中。
--   因为 lt 可能需要理解为有符号值。
--------------------------------------------------------------------------------

-- 实际上，在 ℕ DayanState 中，lt 是非负的。
-- 但递推会产生"概念上的负值"，我们用 ∸ 截断。
-- 
-- 正确的不变量应该用 ℤ 状态。让我们定义一个 ℤ 版的状态。
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- §3. ℤ 版状态与不变量
--------------------------------------------------------------------------------

record DayanStateZ : Set where
  constructor dayanZ
  field
    lt' : ℤ    -- 有符号系数 s_n
    lb' : ℤ    -- 有符号系数 s_{n-1}
    rt' : ℕ    -- 余数 r_n（非负）
    rb' : ℕ    -- 余数 r_{n-1}（非负）

open DayanStateZ public

-- ℕ 转 ℤ
ℕ→ℤ : ℕ → ℤ
ℕ→ℤ n = + n

-- 不变量：∃ k ∈ ℤ, s_n × 奇 + k × 定 = r_n
-- 即 s_n × 奇 ≡ r_n (mod 定)
InvariantMod : (奇 定 : ℕ) → DayanStateZ → Set
InvariantMod 奇 定 s =
  Σ ℤ (λ k → lt' s *ℤ (ℕ→ℤ 奇) +ℤ k *ℤ (ℕ→ℤ 定) ≡ ℕ→ℤ (rt' s))

--------------------------------------------------------------------------------
-- §4. 初始状态
--------------------------------------------------------------------------------

dayan-initZ : (奇 定 : ℕ) → DayanStateZ
dayan-initZ 奇 定 = dayanZ 1ℤ 0ℤ 奇 定

--------------------------------------------------------------------------------
-- §5. 义务 1：初始不变量
--
--   初始：lt=1, lb=0, rt=奇
--   验证：1×奇 + 0×定 = 奇 ✓（取 k=0）
--------------------------------------------------------------------------------

init-invariant : ∀ (奇 定 : ℕ) → InvariantMod 奇 定 (dayan-initZ 奇 定)
init-invariant 奇 定 = (+ 0 , trans (cong₂ _+ℤ_ (*-identityˡ (ℕ→ℤ 奇)) (*-zeroˡ (ℕ→ℤ 定))) (+-identityʳ (ℕ→ℤ 奇)))
-- 1×奇 + 0×定 = 奇 + 0 = 奇
-- 用 *-identityˡ : 1ℤ *ℤ x ≡ x
-- 用 *-zeroˡ : 0ℤ *ℤ x ≡ 0ℤ
-- 用 +-identityʳ : x +ℤ 0ℤ ≡ x
-- 1 × 奇 + 0 × 定 = 奇 + 0 = 奇（取 k=0）

--------------------------------------------------------------------------------
-- §6. step-invariant 类型（证明体需要 ℤ 代数推导）
--
--   需要证明：
--   给定 inv : lt×奇 + k×定 = rt
--   和除法：rb = q×rt + r
--   证明：∃ k', (lb - q×lt)×奇 + k'×定 = r
--
--   推导：
--   (lb - q×lt)×奇 = lb×奇 - q×lt×奇
--   = (lb×奇 - q×lt×奇) + lt×定 - lt×定   ← 加减 lt×定
--   = lb×奇 + lt×(-q×奇+定) - lt×定
--
--   利用旧不变量 lb×奇 + k₂×定 = rb（前一步的不变量）：
--
--   这需要同时维护两步的不变量——即不变量应该是**成对**的：
--   InvariantPair := InvariantMod(当前) × InvariantMod(前一步)
--
--   这就是为什么 DayanState 有两个 left 格！
--------------------------------------------------------------------------------

-- 成对不变量：当前步和前一步都满足模关系
InvariantPair : (奇 定 : ℕ) → DayanStateZ → Set
InvariantPair 奇 定 s =
  (Σ ℤ (λ k → lt' s *ℤ (ℕ→ℤ 奇) +ℤ k *ℤ (ℕ→ℤ 定) ≡ ℕ→ℤ (rt' s)))
  ×
  (Σ ℤ (λ k → lb' s *ℤ (ℕ→ℤ 奇) +ℤ k *ℤ (ℕ→ℤ 定) ≡ ℕ→ℤ (rb' s)))

--------------------------------------------------------------------------------
-- §7. 完整度评估
--
--   ✅ 不变量形式确定：∃k, lt×奇+k×定=rt（模等价）
--   ✅ init-invariant：证明完成（k=0, *-identityˡ, +-identityʳ）
--   ⚠ step-invariant：需要成对不变量+ℤ分配律（框架已给出）
--   ⚠ terminate-correct：rt=1 时 ∃k, lt×奇+k×定=1 ⟹ lt×奇≡1 mod 定
--
--   关键进步：不变量形式从"等式"修正为"模等价（∃k）"，
--   并且识别出需要"成对不变量"（当前步+前一步）。
--------------------------------------------------------------------------------
