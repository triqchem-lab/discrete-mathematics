--   最佳 Q16 表示：√3 → 113511（floor），√3/2 → 56756
-- 此处定义分子分母
GAP_NUM : ℕ
GAP_NUM = 56632

GAP_DEN : ℕ
GAP_DEN = 65536

--------------------------------------------------------------------------------
-- 3. 主权周期 (Sovereign Periodicity)
--------------------------------------------------------------------------------

-- 3 的 11 次方：177,147
-- 用于仲吕闭合操作的乘法因子
POW3₁₁ : ℕ
POW3₁₁ = 177147

-- 2 的 16 次方：65,536
-- 用于仲吕闭合操作的除法因子
POW2₁₆ : ℕ
POW2₁₆ = 65536

-- 主权 LCM 模数：3^11 * 2^16 = 11,609,505,792
-- 极向与环向同步归零的工程周期
SOVEREIGN_LCM : ℕ
SOVEREIGN_LCM = POW3₁₁ * POW2₁₆
